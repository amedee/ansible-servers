{
	"name": "Ansible Lightweight",

	"build": {
		"dockerfile": "Dockerfile",
		"context": "."
	},

	"features": {
		"ghcr.io/devcontainers/features/common-utils:2": {},
		"ghcr.io/devcontainers/features/github-cli:1": {},
		"ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
			"moby": false
		}
	},

	"postCreateCommand": "python -m pip install --upgrade pip && python -m pip install -r requirements-molecule.txt",

	"remoteUser": "vscode",

	"customizations": {
		"vscode": {
			"extensions": [
				"redhat.ansible",
				"redhat.vscode-yaml",
				"ms-python.python",
				"timonwong.shellcheck"
			]
		}
	}
}
