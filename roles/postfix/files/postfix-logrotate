/var/log/mail.err
/var/log/mail.info
/var/log/mail.log
/var/log/mail.warn
{
      compress
      delaycompress
      missingok
      monthly
      notifempty
      rotate 24
      sharedscripts
      su root root

      postrotate
        systemctl reload rsyslog >/dev/null 2>&1 || true
        systemctl reload postfix >/dev/null 2>&1 || true
      endscript
}
