# Server Block for HTTPS
server {
    root {{ nginx_directory | default('/var/www/html') }};
    index {{ nginx_default_indexfiles | default(['index.php']) | join(' ') }};
    server_name {{ nginx_hostname }};

    set $skip_cache 0;

    # Never cache POST requests
    if ($request_method = POST) {
        set $skip_cache 1;
    }

    # Never cache requests with query strings
    if ($args != "") {
        set $skip_cache 1;
    }

    # Never cache logged-in users
    if ($http_cookie ~* "wordpress_logged_in") {
        set $skip_cache 1;
    }

    # Never cache password-protected posts
    if ($http_cookie ~* "wp-postpass") {
        set $skip_cache 1;
    }

    location / {
        limit_req zone=mylimit burst=20 nodelay;
        try_files $uri $uri/ /index.php?$args;
    }

    # PHP Processing
    location ~ \.php$ {
        include snippets/fastcgi-php.conf;

        fastcgi_pass unix:/var/run/php/php{{ nginx_php_version }}-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;

        fastcgi_cache wordpress;
        fastcgi_cache_key "$scheme$request_method$host$request_uri";

        fastcgi_cache_valid 200 10m;
        fastcgi_cache_valid 301 302 10m;

        fastcgi_cache_methods GET HEAD;

        fastcgi_cache_bypass $skip_cache;
        fastcgi_no_cache $skip_cache;

        fastcgi_cache_lock on;
        fastcgi_cache_lock_timeout 10s;

        fastcgi_cache_background_update on;

        fastcgi_cache_use_stale
            error
            timeout
            invalid_header
            updating
            http_500
            http_503;

        add_header X-FastCGI-Cache $upstream_cache_status always;
    }

    # Restrict Access to Hidden Files
    location ~ /\.ht {
        deny all;
    }

    # Logging Configurations
    location = /favicon.ico {
        access_log off;
        log_not_found off;
    }

    location = /robots.txt {
        access_log off;
        allow all;
        log_not_found off;
        try_files $uri /?robots=1;
    }

    # Static Files Caching
    location ~* \.(css|gif|ico|jpeg|jpg|js|png|svg|woff|woff2|eot|ttf|otf)$ {
        expires 1y;
        log_not_found off;
        try_files $uri =404;
    }

    # Deny Access to .user.ini
    location ~ ^/\.user\.ini {
        deny all;
    }

    # Disable Unwanted HTTP Requests
    if ($request_method !~ ^(GET|HEAD|POST)$) {
        return 444;
    }

{% if nginx_ssl_enabled | default(true) %}
    # SSL Configuration
    listen 443 ssl; # managed by Certbot
    listen [::]:443 ssl;

    add_header Strict-Transport-Security "max-age=300" always;

    ssl_certificate /etc/letsencrypt/live/{{ nginx_hostname }}/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/{{ nginx_hostname }}/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
{% endif %}
}

# Redirect all HTTP traffic to HTTPS
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    server_tokens off;

    location / {
        return 301 https://{{ nginx_hostname }}$request_uri;
    }
}
